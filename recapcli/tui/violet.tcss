/* 黑底薄荷绿终端：对话正文和独立状态栏。 */
Screen { background: #080b0a; color: #dce4de; }
#shell { height: 100%; }
#stage { width: 1fr; height: 100%; }
#topbar { height: 3; padding: 1 3 0 2; }
#brand { width: 1fr; color: #b7c5bc; text-style: bold; }
#studio { width: auto; color: #92a79a; margin-right: 3; }
#model { width: auto; max-width: 32; color: #b7c5bc; }
#conversation { height: 1fr; padding: 1 3 0 3; align-horizontal: left; scrollbar-size-vertical: 1; scrollbar-color: #354c3f; scrollbar-background: #080b0a; }
#transcript { width: 1fr; max-width: 112; height: auto; min-height: 100%; }
.turn { height: auto; margin-bottom: 2; }
.user-turn { border-left: solid #49dba5; padding: 0 1; }
.assistant-turn { background: #101512; padding: 1 2; }
.info-turn { color: #92a79a; }
.error-turn { color: #f19f9c; }
#activity { height: 1; margin: 0 3; }
#stream-cursor { height: 1; color: #49dba5; margin-bottom: 1; }
#composer { height: 3; margin: 0 3; padding: 1 0; background: #080b0a; }
#input-prefix { width: 2; height: 1; color: #49dba5; }
#prompt { width: 1fr; height: 1; border: none; padding: 0; background: transparent; color: #dce4de; }
#prompt:focus { border: none; background: transparent; }
#prompt > .input--placeholder { color: #92a79a; }
#prompt > .input--cursor { background: #49dba5; color: #080b0a; }
#prompt > .input--selection { background: #49dba5 25%; }
#send { width: 3; height: 1; color: #92a79a; content-align: right middle; }
#send:hover, #send:focus { color: #49dba5; }
#key-hints { height: 2; margin: 0 3; color: #92a79a; }
#inspector { width: 34; height: 100%; padding: 3 3 1 3; border-left: solid #202923; scrollbar-size-vertical: 1; scrollbar-color: #354c3f; scrollbar-background: #080b0a; }
#inspector-brand { height: 1; color: #49dba5; text-style: bold; margin-bottom: 1; }
#inspector-subtitle { color: #92a79a; margin-bottom: 1; }
.section-title { margin-top: 1; color: #dce4de; text-style: bold; }
.secondary { color: #92a79a; }
#workspace-path { color: #b7c5bc; }
#usage, #modified-files, #tool-capabilities { color: #b7c5bc; }
Screen.-inspector-hidden #inspector { display: none; }
Screen.-compact #inspector, Screen.-compact #studio { display: none; }
Screen.-compact #conversation { padding: 1 2 0 2; }
Screen.-narrow #topbar { padding: 1 1 0 1; }
Screen.-narrow #model { max-width: 26; }
Screen.-narrow #conversation { padding: 1 1 0 1; }
Screen.-narrow #composer, Screen.-narrow #key-hints { margin-left: 1; margin-right: 1; }
Screen.-narrow .assistant-turn { padding: 1; }
