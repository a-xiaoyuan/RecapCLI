/* 浅灰底铺满 TUI，深灰正文，橙色强调。色值与 theme.py PALETTE 手写同步。 */
Screen { background: #f3f0eb; color: #3c3834; }
#shell { height: 100%; background: #f3f0eb; }
#stage { width: 1fr; height: 100%; background: #f3f0eb; }
#task-inspector { display: none; dock: right; width: 32; height: 100%; border-left: solid #d9d1c7; padding: 1 2; background: #f7f4ef; }
Screen.-wide #task-inspector { display: block; }
#conversation { width: 1fr; height: 1fr; padding: 1 2 0 2; align-horizontal: left; scrollbar-size-vertical: 1; scrollbar-gutter: stable; scrollbar-color: #cfc6bb; scrollbar-background: #f3f0eb; background: #f3f0eb; }
#history { width: 100%; height: auto; min-height: 100%; background: #f3f0eb; }
#footer-frame { width: 1fr; height: auto; padding: 1 3 0 2; align-horizontal: left; background: #f3f0eb; }
#footer { width: 100%; height: auto; background: #f3f0eb; }
#welcome { width: 100%; max-width: 86; height: auto; border: round #d4652a; border-title-align: left; border-title-color: #d4652a; padding: 0 1; margin-bottom: 1; background: #f7f4ef; }
#welcome-columns { height: auto; }
#welcome-primary { width: 1fr; height: auto; padding-right: 1; }
#welcome-mark { height: auto; margin-bottom: 1; }
#welcome-message, #welcome-agent { height: auto; }
#welcome-message { color: #3c3834; text-style: bold; }
#welcome-subtitle { height: 1; color: #6f675f; margin-bottom: 1; }
#welcome-tips { width: 32; height: auto; border-left: solid #d9d1c7; padding-left: 2; }
#welcome-tips-title { height: 1; color: #d4652a; text-style: bold; }
#welcome-tips-body { height: auto; color: #6f675f; }
Screen.-narrow #welcome { margin-bottom: 0; }
Screen.-narrow #welcome-columns { layout: vertical; }
Screen.-narrow #welcome-mark { margin-bottom: 0; }
Screen.-narrow #welcome-subtitle { margin-bottom: 0; }
Screen.-narrow #welcome-tips { width: 1fr; border-left: none; padding-left: 0; margin-top: 0; }
Screen.-narrow #welcome-tips-title { display: none; }
#transcript { width: 1fr; height: auto; background: #f3f0eb; }
.turn { height: auto; margin-bottom: 1; }
.user-turn, .assistant-turn { color: #3c3834; }
.user-turn { width: auto; max-width: 100%; background: #f4e6d8; border: none; padding: 0 1; margin: 0 0 1 0; }
.assistant-turn { width: 100%; background: #f3f0eb; border: none; padding: 0; }
.progress-turn { padding-left: 1; color: #3c3834; }
.info-turn { color: #8d857c; padding-left: 2; }
.error-turn { color: #c44545; padding-left: 2; }
#stream-cursor { height: 1; color: #d4652a; margin-bottom: 1; }
#composer { width: 1fr; height: auto; min-height: 3; margin: 0; border: round #d9d1c7; background: #f7f4ef; padding: 0 1; }
#composer:focus-within { border: round #d4652a; }
#input-prefix { width: 11; height: 1; color: #d4652a; text-style: bold; }
Screen.-narrow #input-prefix { width: 2; }
#prompt { width: 1fr; height: 1; min-height: 1; border: none; padding: 0; background: #f7f4ef; color: #3c3834; scrollbar-size-vertical: 1; scrollbar-size-horizontal: 0; }
#prompt:focus { border: none; background: #f7f4ef; }
#prompt > .text-area--placeholder { color: #8d857c; }
#prompt > .text-area--suggestion { color: #8d857c; }
#prompt > .text-area--cursor { background: #d4652a; color: #fffaf6; }
#prompt > .text-area--selection { background: #d4652a 30%; }
#send { width: 3; height: 1; color: #d4652a; content-align: right middle; }
#send:hover, #send:focus { color: #c45c26; text-style: bold; }
#status-row { width: 1fr; height: 1; margin: 0; }
#status-line { width: 1fr; height: 1; color: #8d857c; }
#jump-latest { width: auto; height: 1; padding-left: 2; color: #d4652a; }
#jump-latest:hover, #jump-latest:focus { text-style: bold; }
#key-hints { width: 1fr; height: 1; margin: 0 0 1 0; color: #6f675f; }
#command-menu { display: none; width: 1fr; height: auto; max-height: 7; margin: 0 0 1 0; border: none; padding: 0 1; background: #f7f4ef; scrollbar-size-vertical: 1; }
#command-menu > .option-list--option { padding: 0; }
#command-menu > .option-list--option-highlighted { background: #f4e6d8; color: #3c3834; text-style: bold; }
#command-help { display: none; width: 1fr; height: auto; max-height: 7; margin: 0; color: #6f675f; }
#command-hint { display: none; width: 1fr; height: 1; margin: 0; color: #8d857c; }
StatusScreen { align: center middle; background: #f3f0eb; }
#status-dialog { width: 76; max-width: 94%; height: 80%; max-height: 34; border: round #d4652a; padding: 1 2; background: #f7f4ef; }
#status-heading { height: 2; }
#status-title { width: 1fr; height: 1; color: #d4652a; text-style: bold; }
#close-status { width: auto; min-width: 10; height: 1; min-height: 1; border: none; padding: 0 1; background: #f7f4ef; color: #3c3834; }
#close-status:focus { color: #d4652a; text-style: bold; }
#status-scroll { height: 1fr; scrollbar-size-vertical: 1; }
#status-body { height: auto; }
/* 设置弹窗：固定列宽上限，字段内部滚动，操作按钮使用单行。 */
ModelPickerScreen, ModelConfigScreen { align: center middle; background: #f3f0eb; }
.settings-dialog { width: 68; max-width: 92%; height: 24; max-height: 90%; border: round #d9d1c7; padding: 1 2; background: #f7f4ef; scrollbar-color: #cfc6bb; scrollbar-background: #f7f4ef; }
ModelPickerScreen .settings-dialog { height: auto; }
.dialog-title { height: 1; margin-bottom: 0; color: #3c3834; text-style: bold; }
.dialog-note { height: auto; margin-top: 1; margin-bottom: 0; color: #6f675f; }
.dialog-scroll { height: 1fr; padding-right: 1; scrollbar-size-vertical: 1; }
.section-title { height: 1; margin-top: 1; color: #d4652a; text-style: bold; }
.settings-dialog Label { height: 1; margin-top: 1; color: #6f675f; }
.field-row { height: 2; }
.settings-dialog .field-label { width: 10; height: 1; margin-top: 0; color: #6f675f; content-align: left middle; }
.settings-dialog .field-input { width: 1fr; height: 1; margin: 0; padding: 0 1; border: none; background: #fffaf6; color: #3c3834; }
.settings-dialog .field-input:focus { border: none; background: #fffdfb; }
.settings-dialog Input, .settings-dialog Select { height: 3; margin: 0; background: #fffaf6; color: #3c3834; border: round #d9d1c7; }
.settings-dialog Input { padding: 0 1; }
.settings-dialog Input > .input--placeholder { color: #8d857c; }
.settings-dialog Input:focus, .settings-dialog Select:focus { border: round #d4652a; background: #fffaf6; color: #3c3834; }
.settings-dialog Select.field-input { height: 1; border: none; background: #fffaf6; }
.settings-dialog Select.field-input SelectCurrent { height: 1; padding: 0 1; border: none; background: #fffaf6; color: #3c3834; }
.settings-dialog SelectCurrent .arrow { color: #6f675f; }
.settings-dialog Checkbox { height: auto; margin-top: 1; padding: 0; border: none; background: #f7f4ef; color: #3c3834; }
.settings-dialog Collapsible { padding: 0; margin-top: 1; border: none; background: #f7f4ef; }
.settings-dialog CollapsibleTitle { background: #f7f4ef; color: #6f675f; padding: 0 1; }
.settings-dialog CollapsibleTitle:hover { color: #3c3834; background: #f4e6d8; }
.dialog-actions { height: 2; min-height: 2; margin-top: 1; border-top: solid #d9d1c7; align-horizontal: right; }
.dialog-actions Button { min-width: 10; height: 1; min-height: 1; margin-left: 1; margin-right: 0; padding: 0 1; border: none; background: #f7f4ef; color: #6f675f; }
.dialog-actions Button:hover { color: #3c3834; background: #f4e6d8; }
.dialog-actions Button:focus { color: #3c3834; text-style: bold; background: #f4e6d8; }
.dialog-actions Button.-primary { background: #f4e6d8; color: #c45c26; text-style: bold; }
.dialog-actions Button.-primary:hover { background: #f0d9c6; }
.dialog-actions Button.-primary:focus { background: #f0d9c6; }
#model-filter { margin-bottom: 1; }
#model-options { height: auto; min-height: 1; max-height: 7; margin: 0; scrollbar-size-vertical: 1; background: #f7f4ef; border: none; }
#model-options > .option-list--option { padding: 0 1; color: #3c3834; }
#model-options > .option-list--option-highlighted { background: #f4e6d8; color: #3c3834; text-style: bold; }
#model-count { height: 1; margin-top: 1; color: #6f675f; }
#config-error { height: auto; max-height: 3; color: #c44545; }
