/* 正文保留终端底色；命令候选贴近输入区，模型信息收在底部。 */
Screen { background: ansi_default; color: #dededc; }
#shell { height: 100%; }
#stage { width: 1fr; height: 100%; }
#conversation { height: 1fr; padding: 1 1 0 1; align-horizontal: left; scrollbar-size-vertical: 1; scrollbar-color: #555555; scrollbar-background: ansi_default; }
#history { height: auto; min-height: 100%; }
#welcome { height: auto; border: round #60656d; padding: 1 2 0 2; margin-bottom: 2; }
#brand { height: auto; width: 1fr; color: #e4e3de; margin-bottom: 1; }
#version { height: 1; color: #b3b1ad; content-align: center middle; }
#transcript { width: 1fr; height: auto; }
.turn { height: auto; margin-bottom: 1; }
.user-turn { background: #202422; }
.assistant-turn { padding: 0 2; }
.info-turn { color: #a09d97; }
.error-turn { color: #f28b91; padding-left: 2; }
#stream-cursor { height: 1; color: #80b6ad; margin-bottom: 1; }
#composer { height: auto; min-height: 3; margin: 0 1; border-top: solid #777777; border-bottom: solid #777777; }
#input-prefix { width: 2; height: 1; color: #b3b1ad; }
#prompt { width: 1fr; height: 1; min-height: 1; border: none; padding: 0; background: ansi_default; color: #dededc; scrollbar-size-vertical: 1; scrollbar-size-horizontal: 0; }
#prompt:focus { border: none; background: ansi_default; }
#prompt > .text-area--placeholder { color: #a09d97; }
#prompt > .text-area--cursor { background: #b3b1ad; color: #0c0c0c; }
#prompt > .text-area--selection { background: #80b6ad 25%; }
#send { width: 3; height: 1; color: #a09d97; content-align: right middle; }
#send:hover, #send:focus { color: #80b6ad; }
#status-row { height: 1; margin: 0 1; }
#status-line { width: 1fr; height: 1; color: #a09d97; }
#jump-latest { width: auto; height: 1; padding-left: 2; color: #80b6ad; }
#jump-latest:hover, #jump-latest:focus { text-style: bold; }
#key-hints { height: 1; margin: 0 1 1 1; color: #a09d97; }
#command-menu { display: none; height: auto; max-height: 7; margin: 0 1; border: none; padding: 0 1; background: ansi_default; scrollbar-size-vertical: 1; }
#command-menu > .option-list--option { padding: 0; }
#command-menu > .option-list--option-highlighted { background: #202422; color: #dededc; text-style: bold; }
#command-help { display: none; height: auto; max-height: 7; margin: 0 2; color: #b3b1ad; }
#command-hint { display: none; height: 1; margin: 0 2; color: #a09d97; }
Screen.-narrow #welcome { margin-bottom: 1; }
Screen.-narrow .assistant-turn { padding: 0 1; }
StatusScreen { align: center middle; background: #0c0c0c 70%; }
#status-dialog { width: 76; max-width: 94%; height: 80%; max-height: 34; border: solid #777777; padding: 1 2; background: #191919; }
#status-heading { height: 2; }
#status-title { width: 1fr; height: 1; color: #80b6ad; text-style: bold; }
#close-status { width: auto; min-width: 10; height: 1; min-height: 1; border: none; padding: 0 1; background: #333333; color: #dededc; }
#close-status:focus { color: #80b6ad; text-style: bold; }
#status-scroll { height: 1fr; scrollbar-size-vertical: 1; }
#status-body { height: auto; }
ModelPickerScreen, ModelConfigScreen { align: center middle; background: #0c0c0c 70%; }
.settings-dialog { width: 86; max-width: 96%; height: 90%; max-height: 40; border: solid #777777; padding: 1 2; background: #191919; }
.dialog-title { height: 2; color: #dededc; text-style: bold; }
.dialog-note { height: auto; margin-bottom: 1; color: #b3b1ad; }
.dialog-scroll { height: 1fr; scrollbar-size-vertical: 1; }
.settings-dialog Input, .settings-dialog Select { height: 3; margin-bottom: 0; }
.settings-dialog Label { height: auto; margin-top: 0; }
.settings-dialog Checkbox { height: 3; }
.settings-dialog Collapsible { padding: 0; }
.dialog-actions { height: 3; margin-top: 1; }
.dialog-actions Button { min-width: 10; margin-right: 1; }
#model-options { height: 1fr; margin-top: 1; scrollbar-size-vertical: 1; }
#model-count { height: auto; color: #b3b1ad; }
#config-error { height: auto; max-height: 3; color: #f28b91; }
