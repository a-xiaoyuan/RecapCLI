/* 真终端：中性炭黑、文字与留白。紫只用于字标、提示符和光标。 */
Screen {
    background: #0b0d0f;
    color: #dddde3;
}
#shell { height: 100%; }
#rail {
    width: 5;
    height: 100%;
    padding-top: 1;
    border-right: solid #202226;
}
#rail.-hidden { display: none; }
.rail-button {
    width: 3;
    height: 3;
    margin: 0 0 1 0;
    content-align: center middle;
    color: #9698a3;
}
.rail-button:hover, .rail-button:focus { color: #cdb9ef; text-style: bold; }
#stage { width: 1fr; height: 100%; }
#topbar {
    height: 4;
    padding: 1 3 0 2;
}
#brand { width: 1fr; color: #cdb9ef; text-style: bold; }
#studio { width: auto; color: #9698a3; margin-right: 3; }
#model { width: auto; max-width: 32; color: #b6b7c0; }
#conversation {
    height: 1fr;
    padding: 3 6 1 6;
    align-horizontal: center;
    scrollbar-size-vertical: 1;
    scrollbar-color: #44454d;
    scrollbar-background: #0b0d0f;
}
#transcript { width: 1fr; max-width: 104; height: auto; }
.turn { height: auto; margin-bottom: 3; }
#stream-cursor { height: 1; margin-top: 0; color: #dddde3; }
#composer {
    height: 3;
    margin: 1 3 2 2;
    padding: 0 1;
    border: round #3c3d43;
    background: #111315;
}
#composer:focus-within { border: round #66636f; }
#input-prefix { width: 2; height: 1; color: #cdb9ef; }
#prompt {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0;
    background: transparent;
    color: #dddde3;
}
#prompt:focus { border: none; background: transparent; }
#prompt > .input--placeholder { color: #9698a3; }
#prompt > .input--cursor { background: #cdb9ef; color: #0b0d0f; }
#prompt > .input--selection { background: #cdb9ef 25%; }
#send { width: 3; height: 1; color: #9698a3; content-align: right middle; }
#send:hover, #send:focus { color: #cdb9ef; }
Screen.-compact #studio { display: none; }
Screen.-compact #conversation { padding: 2 3 1 3; }
Screen.-narrow #topbar { padding: 1 1 0 1; height: 3; }
Screen.-narrow #model { max-width: 26; }
Screen.-narrow #conversation { padding: 2 1 1 1; }
Screen.-narrow #composer { margin: 1 1 1 1; }
