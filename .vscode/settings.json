{
  "files.exclude": {
    "**/.venv": true,
    "**/venv": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/.recapcli": true,
    "**/.revocli": true,
    "**/.archer": true,
    "**/dist": true,
    "**/build": true,
    "**/*.egg-info": true,
    "**/_testtmp": true,
    "**/logs": true
  },
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/venv/**": true,
    "**/__pycache__/**": true,
    "**/.pytest_cache/**": true,
    "**/.mypy_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/.recapcli/**": true,
    "**/.revocli/**": true,
    "**/.archer/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/_testtmp/**": true,
    "**/logs/**": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/venv": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/.recapcli": true,
    "**/.revocli": true,
    "**/.archer": true,
    "**/dist": true,
    "**/build": true,
    "**/*.egg-info": true,
    "**/_testtmp": true,
    "**/logs": true
  },
  "python.analysis.exclude": [
    ".venv",
    "venv",
    "**/__pycache__",
    ".pytest_cache",
    ".mypy_cache",
    ".ruff_cache",
    ".recapcli",
    ".revocli",
    ".archer",
    "dist",
    "build",
    "_testtmp",
    "logs"
  ],
  "python.analysis.autoSearchPaths": false,
  "python.analysis.extraPaths": [],
  "python.analysis.diagnosticMode": "workspace"
