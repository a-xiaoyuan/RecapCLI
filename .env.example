# Required: credentials and a model that supports the selected tool-call protocol.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional: chat_completions (default) or responses.
# OPENAI_PROTOCOL=chat_completions
# More profiles: copy models.example.toml to models.toml; keys stay in .env.
# BACKUP_API_KEY=

# Optional: API root for an OpenAI-compatible provider.
# Leave unset to use the OpenAI SDK default endpoint.
# OPENAI_BASE_URL=https://your-provider.example/v1

# Optional search: --allow-network uses Tavily; --allow-web supports Brave/Tavily.
# URL reading needs no search key. Configuration comes from RecapCLI, not the target workspace.
# BRAVE_API_KEY=
# TAVILY_API_KEY=
# For --allow-web: brave or tavily; auto-select when unset.
# RECAP_WEB_PROVIDER=brave
# REVO_WEB_PROVIDER is still accepted. If both are set they must match.
